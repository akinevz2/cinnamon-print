# intermediates & artifacts
project/output/*
# ...but metadata sidecars are versioned (projects sidebar content)
!project/output/*.json
project/compose.html
project/compose.body.html
project/compose-measure.html
result*
.image-built
imagework.zip

# runtime caches / local state
.cache/
.config/
.local/
node_modules/

# opencode repl profile (auth, sessions, config state) — persists between
# repl runs, lives in the repo dir but is never committed
.opencode/cache/

# repl session logs (livereload server + compose output) — /work/logs in the
# container, mounted bidirectionally with the repo
logs/

# windows zone-identifier droppings
*Zone.Identifier*

# trashed projects/frag files — restorable by moving back to their original path
.opencode/trash/
