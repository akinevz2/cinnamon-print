const int NLINES = 2;
const int LINE_LEN[NLINES] = int[NLINES](11, 19);
const int LINE_OFF[NLINES] = int[NLINES](0, 11);
const int LINE_W[NLINES] = int[NLINES](135, 337);
const float LINE_TOP[NLINES] = float[NLINES](0.0000, 32.0000);
const float LINE_H[NLINES] = float[NLINES](26.0000, 26.0000);
const float LSCALE[NLINES] = float[NLINES](1.0000, 1.0000);
const int TEXT_ALL = 30;
const int LINE_DATA[TEXT_ALL] = int[TEXT_ALL](8, 19, 26, 8, 18, 26, 19, 8, 12, 4, 27, 24, 14, 20, 26, 10, 13, 14, 22, 26, 22, 7, 0, 19, 26, 19, 8, 12, 4, 27);

const float S = 6.0000;
const float TH = radians(0.0);
const float TAPER = 0.0000;
const float WB = 337.0000;
const float HB = 58.0000;
const float BAND_L0 = 2022.0000;
const float BAND_H0 = 348.0000;
const float PAD = 34.0000;
const vec3 FILL = vec3(255, 243, 214) / 255.0;   // #fff3d6 warm white
const vec3 OUTLINE = vec3(32, 4, 4) / 255.0;     // #200404 — family dark

bool glyphOn(int gi, vec2 gp) {
  if (gi < 0 || gi >= PAL_LEN) return false;
  int w = GW[gi];
  if (gp.x < 0.0 || gp.x >= float(w) || gp.y < 0.0 || gp.y >= float(CELL)) return false;
  ivec2 c = ivec2(floor(gp));
  // block space is y-DOWN (v = 0 at block top): top-down glyph rows map
  // directly. NO row flip here — the intro's flip assumes GL y-up cell space.
  int row = c.y;
  return ((GDATA[CELL * gi + row] >> (w - 1 - c.x)) & 1) == 1;
}

/* block-space ink test with per-line scale: bx in [0,WB), by in [0,HB) */
bool blockOn(vec2 bp) {
  if (bp.x < 0.0 || bp.x >= WB || bp.y < 0.0 || bp.y >= HB) return false;
  for (int li = 0; li < NLINES; li++) {
    if (bp.y < LINE_TOP[li] || bp.y >= LINE_TOP[li] + LINE_H[li]) continue;
    float sc = LSCALE[li];
    float gx = (bp.x - (WB - float(LINE_W[li]) * sc) * 0.5) / sc;  // line centered
    float gy = (bp.y - LINE_TOP[li]) / sc;
    float x = 0.0;
    for (int k = 0; k < LINE_LEN[li]; k++) {
      int gi = LINE_DATA[LINE_OFF[li] + k];
      float w = float(GW[gi]);
      if (gx >= x && gx < x + w) return glyphOn(gi, vec2(gx - x, gy));
      x += w + 1.0;
      if (x > gx) break;
    }
    return false;
  }
  return false;
}

void main() {
  // resolution-relative: identical composition at any render size
  float R = u_resolution.y / 2400.0;
  vec2 CENTER = u_resolution * 0.5;
  float BAND_L = BAND_L0 * R;
  float BAND_H = BAND_H0 * R;
  vec2 p = gl_FragCoord.xy - CENTER;
  float c = cos(TH), s = sin(TH);
  vec2 band = vec2(c * p.x + s * p.y, -s * p.x + c * p.y);  // rotate by -TH
  if (abs(band.x) > BAND_L * 0.5 + 4.0 * R || abs(band.y) > BAND_H * 0.5 + 4.0 * R) {
    outColor = vec4(0.0); return;
  }
  float t = band.x / BAND_L + 0.5;               // [0,1] along text (start = t 0)
  // TAPER = 0: straight mapping (a 0/0 quadratic would NaN every glyph)
  float u = t;
  float f = 1.0;
  float v = 0.5 - band.y * f / BAND_H;           // [0,1] across (0 = block top)
  vec2 bp = vec2(u * WB, v * HB);                // block space

  // 4-tap supersample (45° rotation -> diagonal edges need it)
  float a = 0.0;
  for (int i = 0; i < 4; i++) {
    vec2 o = vec2(i < 2 ? -0.25 : 0.25, (i & 1) == 0 ? -0.25 : 0.25);
    a += blockOn(bp + o) ? 0.25 : 0.0;
  }
  // 2px outline ring in block space (24 neighbours) — pops off the busy bg
  bool edge = false;
  if (a <= 0.0) {
    for (int dy = -2; dy <= 2 && !edge; dy++) {
      for (int dx = -2; dx <= 2; dx++) {
        if (dx == 0 && dy == 0) continue;
        if (blockOn(bp + vec2(float(dx), float(dy)))) { edge = true; break; }
      }
    }
  }

  // dark rounded backing plate: guarantees readability over the ramble spam
  vec2 he = vec2(BAND_L, BAND_H) * 0.5 + vec2(PAD * R);
  float rr = 56.0 * R;
  vec2 q = abs(p) - (he - rr);
  float sd = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - rr;
  bool plate = sd < 0.0;

  if (a > 0.0) outColor = vec4(FILL, 1.0);
  else if (edge) outColor = vec4(OUTLINE, 1.0);
  else if (plate) outColor = vec4(OUTLINE, 0.93);
  else outColor = vec4(0.0);
}
