bool glyphOn(int gi, vec2 gp) {
  if (gi < 0 || gi >= PAL_LEN) return false;
  int w = GW[gi];
  if (gp.x < 0.0 || gp.x >= float(w) || gp.y < 0.0 || gp.y >= float(CELL)) return false;
  ivec2 c = ivec2(floor(gp));
  int row = 25 - c.y;           // flip: bottom-up fragcoord
  return ((GDATA[CELL * gi + row] >> (w - 1 - c.x)) & 1) == 1;
}

/* block-space ink test: bx in [0,WB) left->right, by in [0,HB) top->bottom */
bool blockOn(vec2 bp) {
  if (bp.x < 0.0 || bp.x >= WB || bp.y < 0.0 || bp.y >= HB) return false;
  int li = int(floor(bp.y / PITCH));
  float ry = bp.y - float(li) * PITCH;
  if (ry >= float(CELL)) return false;           // leading gap between lines
  float x = (WB - float(LINE_W[li])) * 0.5;      // line centered in block
  for (int k = 0; k < LINE_LEN[li]; k++) {
    int gi = LINE_DATA[LINE_OFF[li] + k];
    float w = float(GW[gi]);
    if (bp.x >= x && bp.x < x + w) return glyphOn(gi, vec2(bp.x - x, ry));
    x += w + 1.0;
    if (x > bp.x) break;
  }
  return false;
}

void main() {
  vec2 p = gl_FragCoord.xy - CENTER;
  float c = cos(TH), s = sin(TH);
  vec2 band = vec2(c * p.x + s * p.y, -s * p.x + c * p.y);  // rotate by -TH
  if (abs(band.x) > BAND_L * 0.5 + 4.0) { outColor = vec4(0.0); return; }
  float t = band.x / BAND_L + 0.5;              // [0,1] along text (start = t 0)
  // planar perspective: solve t = (u + TAPER*u^2/2) / (1 + TAPER/2) for u
  float u = (-1.0 + sqrt(1.0 + 2.0 * TAPER * t * (1.0 + TAPER * 0.5))) / TAPER;
  float f = 1.0 + TAPER * u;                     // 1/f = screen shrink at u
  float v = 0.5 - band.y * f / BAND_H;           // [0,1] across (0 = block top)
  vec2 bp = vec2(u * WB, v * HB);                // block space

  // 4-tap supersample in block space (chunky edges, calmed stair-stepping)
  float a = 0.0;
  for (int i = 0; i < 4; i++) {
    vec2 o = vec2(i < 2 ? -0.25 : 0.25, (i & 1) == 0 ? -0.25 : 0.25);
    a += blockOn(bp + o) ? 0.25 : 0.0;
  }
  // 1px outline in block space (8-neighbourhood at the block centre)
  bool edge = false;
  if (a <= 0.0) {
    for (int dy = -1; dy <= 1 && !edge; dy++) {
      for (int dx = -1; dx <= 1; dx++) {
        if (dx == 0 && dy == 0) continue;
        if (blockOn(bp + vec2(float(dx), float(dy)))) { edge = true; break; }
      }
    }
  }

  if (a > 0.0) outColor = vec4(FILL, 1.0);
  else if (edge) outColor = vec4(OUTLINE, 1.0);
  else outColor = vec4(0.0);
}
